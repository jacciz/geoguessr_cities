create_map_of_guesses_by_location <- function(
score_by_location_id,
google_file_path,
starting_view
) {
round_no <- 1
score_by_location <- read_sheet(score_by_location_id)
seqnum_list <- unique(score_by_location$seqnum)
for (i in 1:length(seqnum_list)) {
filtered_data <- score_by_location %>% filter(seqnum == seqnum_list[i])
# Create a leaflet map
map <- leaflet() %>%
# addProviderTiles(providers$CartoDB.Positron)
addTiles(
urlTemplate = url,
attribution = paste(
'&copy; <a href="https://carto.com/attributions">CARTO</a>,',
'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
)
)
# Add lines connecting each guess to its corresponding actual coordinate
for (i in 1:nrow(filtered_data)) {
map <- map %>%
addPolylines(
lng = c(filtered_data$longitude[i], filtered_data$longitude_guess[i]),
lat = c(filtered_data$latitude[i], filtered_data$latitude_guess[i]),
color = "black",
opacity = 1,
weight = 1
)
}
# Add points for actual coordinates
map <- map %>%
addCircleMarkers(
data = filtered_data,
lng = ~longitude,
lat = ~latitude,
color = "yellow",
stroke = TRUE,
weight = 4,
fillColor = "black",
fillOpacity = 1,
radius = 5,
popup = ~ paste("Actual location ", max(filtered_data$seqnum))
)
# Add points for guessed coordinates
map <- map %>%
addCircleMarkers(
data = filtered_data,
lng = ~longitude_guess,
lat = ~latitude_guess,
color = "black",
stroke = TRUE,
weight = 2,
fillColor = "red",
fillOpacity = 1,
radius = 5,
popup = ~ paste(
team_name,
"<br>",
"Distance: ",
distance_label,
"<br>",
"Score: ",
score
)
)
# if (city=="DC"){
#   map<-map%>%
#     setView(lng = -77.0369, lat = 38.9072, zoom = 11)
#   }
# if (city=="NYC"){
map <- map %>%
setView(
lng = starting_view[["lng"]],
1766,
lat = starting_view[["lat"]],
zoom = 10
)
# }
# Render the map
print(max(filtered_data$seqnum))
print(map)
# Create a temporary local HTML file
# tmp_html <- tempfile(fileext = ".html")
#
# htmlwidgets::saveWidget(
#   map,
#   file = tmp_html,
#   selfcontained = TRUE
# )
#
# # Upload to Google Drive
# googledrive::drive_upload(
#   media = tmp_html,
#   path = google_file_path,
#   name = paste0(
#     "round_",
#     round_no,
#     "_location_",
#     max(filtered_data$seqnum),
#     ".html"
#   ),
#   overwrite = TRUE
# )
}
}
create_map_of_guesses_by_location(
score_by_location_id,
google_file_path,
starting_view
)
fluidRow(
by_location,
by_user,
br(),
lapply(1:2, function(i) {
column(
width = 6,
div(
div(class = "mapTitle", paste("Location", i)),
create_map_of_guesses_by_location(
score_by_location_id,
google_file_path,
starting_view
)
# tags$iframe(
#   id = paste0("map_container", i),
#   class = "mapContainer",
#   src = paste0("round_1_location_", i, ".html"),
#   width = "100%",
#   height = "700px",
#   style = "border: none;"
# )
)
)
})
)
by_user <- googlesheets4::read_sheet(
ss = "16jr22Ob9jWK0K6zhLtsw8zMTEnvelYZBFoj0Sz9buT0",
sheet = "Sheet1"
) |>
dplyr::rename("User" = "team_name", "Score" = "score") |>
dplyr::arrange(rev(Score)) |>
gt::gt(caption = "Scores by Identity") |>
gt::as_raw_html()
fluidRow(
by_location,
by_user,
br(),
lapply(1:2, function(i) {
column(
width = 6,
div(
div(class = "mapTitle", paste("Location", i)),
create_map_of_guesses_by_location(
score_by_location_id,
google_file_path,
starting_view
)
# tags$iframe(
